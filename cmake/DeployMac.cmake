cmake_minimum_required(VERSION 3.21)
if(NOT EXISTS "${APP_BUNDLE}/Contents/Info.plist" OR NOT EXISTS "${QT_ROOT}/bin/macdeployqt")
    message(FATAL_ERROR "Pass -DAPP_BUNDLE=/path/to/VK.app -DQT_ROOT=/path/to/Qt/macos")
endif()
get_filename_component(APP_BUNDLE "${APP_BUNDLE}" ABSOLUTE)
get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(KEY IN ITEMS CFBundleExecutable CFBundleIdentifier CFBundleShortVersionString)
    execute_process(COMMAND /usr/libexec/PlistBuddy -c "Print :${KEY}" "${APP_BUNDLE}/Contents/Info.plist"
        RESULT_VARIABLE PLIST_RESULT OUTPUT_VARIABLE PLIST_VALUE ERROR_VARIABLE PLIST_ERROR OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT PLIST_RESULT EQUAL 0 OR PLIST_VALUE STREQUAL "")
        message(FATAL_ERROR "Invalid Info.plist: ${KEY} is empty: ${PLIST_ERROR}")
    endif()
    if(KEY STREQUAL "CFBundleExecutable" AND NOT EXISTS "${APP_BUNDLE}/Contents/MacOS/${PLIST_VALUE}")
        message(FATAL_ERROR "Bundle executable is missing: ${PLIST_VALUE}")
    endif()
endforeach()

# Ship only plugins this client uses; unrelated SQL drivers in a full Qt SDK
# may depend on database clients absent on the developer's or user's machine.
file(REMOVE_RECURSE "${APP_BUNDLE}/Contents/PlugIns/sqldrivers")
set(PLUGIN_ARGUMENTS)
set(PLUGIN_FILES)
foreach(PLUGIN IN ITEMS platforms/libqcocoa.dylib platforms/libqoffscreen.dylib tls/libqsecuretransportbackend.dylib imageformats/libqjpeg.dylib imageformats/libqgif.dylib
    sqldrivers/libqsqlite.dylib multimedia/libdarwinmediaplugin.dylib multimedia/libffmpegmediaplugin.dylib)
    if(NOT EXISTS "${QT_ROOT}/plugins/${PLUGIN}")
        message(FATAL_ERROR "Missing Qt plugin: ${PLUGIN}")
    endif()
    get_filename_component(CATEGORY "${PLUGIN}" DIRECTORY)
    file(COPY "${QT_ROOT}/plugins/${PLUGIN}" DESTINATION "${APP_BUNDLE}/Contents/PlugIns/${CATEGORY}")
    list(APPEND PLUGIN_ARGUMENTS "-executable=${APP_BUNDLE}/Contents/PlugIns/${PLUGIN}")
    list(APPEND PLUGIN_FILES "${APP_BUNDLE}/Contents/PlugIns/${PLUGIN}")
endforeach()
message("Deploying Qt frameworks and QML...")
execute_process(
    COMMAND "${QT_ROOT}/bin/macdeployqt" "${APP_BUNDLE}" -no-plugins -no-codesign "-qmldir=${SOURCE_DIR}/qml"
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0 OR "${OUTPUT}${ERROR}" MATCHES "ERROR:")
    message(FATAL_ERROR "QML deployment failed: ${OUTPUT}${ERROR}")
endif()
# macdeployqt places QML libraries behind symlinks into PlugIns/quick. With
# -no-plugins those targets are omitted, so deploy the libraries explicitly.
file(GLOB_RECURSE QML_PLUGINS RELATIVE "${QT_ROOT}/qml" "${QT_ROOT}/qml/*.dylib")
foreach(PLUGIN IN LISTS QML_PLUGINS)
    get_filename_component(MODULE_DIRECTORY "${PLUGIN}" DIRECTORY)
    if(EXISTS "${APP_BUNDLE}/Contents/Resources/qml/${MODULE_DIRECTORY}/qmldir")
        set(DESTINATION "${APP_BUNDLE}/Contents/Resources/qml/${PLUGIN}")
        file(REMOVE "${DESTINATION}")
        file(COPY_FILE "${QT_ROOT}/qml/${PLUGIN}" "${DESTINATION}")
        list(APPEND PLUGIN_ARGUMENTS "-executable=${DESTINATION}")
        list(APPEND PLUGIN_FILES "${DESTINATION}")
    endif()
endforeach()
message("Deploying QML, SQLite and multimedia plugins...")
execute_process(
    COMMAND "${QT_ROOT}/bin/macdeployqt" "${APP_BUNDLE}" -no-plugins -no-codesign -always-overwrite "-qmldir=${SOURCE_DIR}/qml" ${PLUGIN_ARGUMENTS}
    RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
message("${OUTPUT}${ERROR}")
# Some macdeployqt releases return success even when dependency resolution fails.
if(NOT RESULT EQUAL 0 OR "${OUTPUT}${ERROR}" MATCHES "ERROR:")
    message(FATAL_ERROR "macdeployqt failed")
endif()
file(GLOB FRAMEWORKS "${APP_BUNDLE}/Contents/Frameworks/*.framework" "${APP_BUNDLE}/Contents/Frameworks/*.dylib")
file(GLOB_RECURSE EMBEDDED_PLUGINS "${APP_BUNDLE}/Contents/PlugIns/*.dylib" "${APP_BUNDLE}/Contents/Resources/qml/*.dylib")
list(APPEND PLUGIN_FILES ${EMBEDDED_PLUGINS})
list(REMOVE_DUPLICATES PLUGIN_FILES)
message("Signing embedded code...")
foreach(CODE IN LISTS FRAMEWORKS PLUGIN_FILES)
    execute_process(COMMAND codesign --force --sign - "${CODE}"
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "Signing failed: ${CODE}: ${OUTPUT}${ERROR}")
    endif()
endforeach()
execute_process(COMMAND codesign --force --sign - "${APP_BUNDLE}" RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Ad-hoc bundle signing failed")
endif()
execute_process(COMMAND codesign --verify --deep --strict "${APP_BUNDLE}" RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Bundle signature verification failed")
endif()
