# Add these locations INSIDE the existing HTTPS server block for
# 153-51-114-47.sslip.io. Keep the existing certificates and other locations.
# Install only index.html, callback.js and style.css into /var/www/vkm-login-return.
location = /callback {
    alias /var/www/vkm-login-return/index.html;
    default_type text/html;
    access_log off;
    # Error entries may contain the request URI, including its query.
    error_log /dev/null crit;
    etag off;
    if_modified_since off;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
}

location ^~ /login-return/ {
    alias /var/www/vkm-login-return/;
    autoindex off;
    access_log off;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    # The existing server's mime.types should define js/css. Limit the files
    # installed in this directory to the three assets listed above.
}
